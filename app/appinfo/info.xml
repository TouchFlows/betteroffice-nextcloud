<?xml version="1.0"?>
<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>betteroffice</id>
	<name>BetterOffice</name>
	<summary>Edit and collaborate on DOCX, XLSX and PPTX files natively in Nextcloud</summary>
	<description><![CDATA[Native DOCX, XLSX and PPTX editing inside Nextcloud Files, with mandatory
real-time collaboration, backed by BetterOffice's WebAssembly editors and a
self-hosted collaboration relay. No Collabora, no ONLYOFFICE, no external
document service, and your files never leave your Nextcloud instance.]]></description>
	<version>0.2.0</version>
	<licence>Apache-2.0</licence>
	<author mail="noreply@touchflows.com" homepage="https://touchflows.com">TouchFlows</author>
	<namespace>BetterOffice</namespace>
	<category>office</category>
	<category>files</category>
	<bugs>https://github.com/TouchFlows/betteroffice-nextcloud/issues</bugs>
	<repository type="git">https://github.com/TouchFlows/betteroffice-nextcloud.git</repository>
	<dependencies>
		<php min-version="8.3"/>
		<database min-version="10.6">mysql</database>
		<database min-version="13">pgsql</database>
		<database>sqlite</database>
		<nextcloud min-version="31" max-version="35"/>
	</dependencies>
	<!-- Settings → Administration → BetterOffice (PLAN.md §4.A, §11). The
	     version above is bumped with this block: Nextcloud registers settings
	     classes on install/update, so an existing installation only picks them
	     up after an upgrade. -->
	<settings>
		<admin>OCA\BetterOffice\Settings\Admin</admin>
		<admin-section>OCA\BetterOffice\Settings\Section</admin-section>
	</settings>
	<navigations>
		<navigation>
			<id>betteroffice</id>
			<name>BetterOffice</name>
			<route>betteroffice.page.index</route>
			<icon>app.svg</icon>
			<type>link</type>
		</navigation>
	</navigations>
</info>
