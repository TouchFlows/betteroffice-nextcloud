{
	"name": "touchflows/betteroffice-nextcloud-app",
	"description": "Nextcloud application for BetterOffice document editing and collaboration",
	"license": "Apache-2.0",
	"type": "project",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"phpunit/phpunit": "^12.3",
		"nextcloud/ocp": "dev-stable35",
		"nextcloud/coding-standard": "^1.5"
	},
	"autoload": {
		"psr-4": {
			"OCA\\BetterOffice\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\BetterOffice\\Tests\\": "tests/",
			"OCP\\": "vendor/nextcloud/ocp/OCP/"
		}
	},
	"scripts": {
		"lint": "php -l lib && php -l appinfo",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"test:unit": "phpunit --testsuite unit"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"platform": {
			"php": "8.3"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true
}
