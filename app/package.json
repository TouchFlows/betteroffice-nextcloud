{
  "name": "@touchflows/betteroffice-nextcloud-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "typecheck:e2e": "node ./node_modules/typescript/bin/tsc --noEmit -p tests/e2e",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:repeat": "playwright test --config tests/e2e/playwright.config.ts --repeat-each=2",
    "test:live": "node tests/live/presence-avatar.mjs"
  },
  "dependencies": {
    "@betteroffice/docx": "0.5.1",
    "@betteroffice/docx-react": "0.5.1",
    "@nextcloud/auth": "2.6.0",
    "@nextcloud/axios": "2.6.0",
    "@nextcloud/files": "4.1.1",
    "@nextcloud/l10n": "3.4.1",
    "@nextcloud/router": "3.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@nextcloud/vite-config": "2.5.4",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/typescript6": "6.0.2",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "7.0.2",
    "vite": "7.3.8"
  },
  "engines": {
    "node": "^20 || ^22 || ^24"
  },
  "overrides": {
    "minimatch": "11.0.9",
    "vite-plugin-dts": "5.1.2"
  }
}
