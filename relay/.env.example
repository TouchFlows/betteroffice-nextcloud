# Copy to .env and fill in real values. The real .env must never be
# committed and must be readable only by the service account that runs the
# relay (chmod 600, owned by that account) -- PLAN.md §14.2.

BETTEROFFICE_RELAY_PORT=8787

# Dedicated database and user (PLAN.md §5.2) -- this account must have no
# access to Nextcloud's own database.
BETTEROFFICE_RELAY_DB_HOST=127.0.0.1
BETTEROFFICE_RELAY_DB_PORT=3306
BETTEROFFICE_RELAY_DB_NAME=betteroffice_relay
BETTEROFFICE_RELAY_DB_USER=betteroffice_relay
BETTEROFFICE_RELAY_DB_PASSWORD=

# Shared with the Nextcloud app's generated admin-settings secret (PLAN.md
# §8.5) -- the app signs collaboration tokens with this, the relay verifies
# them with it. Same "internal secret" pattern as Nextcloud Talk's
# signaling backend. Required by the server (src/server.ts), not by
# `npm run migrate`.
BETTEROFFICE_RELAY_SHARED_SECRET=

# The exact origin (scheme + host [+ port]) the Nextcloud app is served
# from, e.g. https://cloud.example.com -- PLAN.md §13 "Strict Origin
# validation". The relay refuses any WebSocket upgrade from another Origin.
BETTEROFFICE_RELAY_ALLOWED_ORIGIN=
